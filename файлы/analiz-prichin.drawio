<mxfile host="app.diagrams.net"><diagram name="Анализ причин"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Анализ проблем: диаграмма Исикавы и «5 почему»" style="text;html=1;align=center;verticalAlign=middle;fontSize=34;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="24" width="2040" height="34" as="geometry"/></mxCell><mxCell id="t2" value="Оптимизация процесса устранения проблем благоустройства и содержания территории Благовещенского муниципального округа за счёт перехода от реагирования на обращения к их плановому выявлению и контролю результата" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=21;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="30" y="62" width="2040" height="60" as="geometry"/></mxCell><mxCell id="spine" value="" style="html=1;endArrow=blockThin;endFill=1;strokeWidth=3;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="560" as="sourcePoint"/><mxPoint x="1660" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="head" value="Проблема на территории существует&lt;br&gt;до 44 дней: администрация узнаёт&lt;br&gt;о ней только из обращения жителя" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C00000;strokeWidth=2.5;fontSize=23;fontStyle=1;verticalAlign=middle;align=center;fontColor=#C00000;spacing=8;" vertex="1" parent="1"><mxGeometry x="1674" y="468" width="396" height="184" as="geometry"/></mxCell><mxCell id="cat0" value="ЛЮДИ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=2;fontSize=25;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="172" width="300" height="58" as="geometry"/></mxCell><mxCell id="bone0" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#2E75B6;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="230" as="sourcePoint"/><mxPoint x="700" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tick0_0" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="388" y="315" as="sourcePoint"/><mxPoint x="478" y="315" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub0_0" value="Территорию никто не обходит планово" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="8" y="277" width="380" height="76" as="geometry"/></mxCell><mxCell id="tick0_1" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="395" as="sourcePoint"/><mxPoint x="550" y="395" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub0_1" value="Ресурс активных жителей не задействован" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="80" y="357" width="380" height="76" as="geometry"/></mxCell><mxCell id="tick0_2" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="532" y="474" as="sourcePoint"/><mxPoint x="622" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub0_2" value="Ответственного определяет лично Глава округа" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="152" y="436" width="380" height="76" as="geometry"/></mxCell><mxCell id="cat1" value="МЕТОДЫ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=2;fontSize=25;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="172" width="300" height="58" as="geometry"/></mxCell><mxCell id="bone1" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#2E75B6;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="230" as="sourcePoint"/><mxPoint x="1150" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tick1_0" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="838" y="315" as="sourcePoint"/><mxPoint x="928" y="315" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub1_0" value="Единственный вход в процесс — обращение жителя" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="458" y="277" width="380" height="76" as="geometry"/></mxCell><mxCell id="tick1_1" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="395" as="sourcePoint"/><mxPoint x="1000" y="395" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub1_1" value="Единый срок 30 дней на любое обращение" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="530" y="357" width="380" height="76" as="geometry"/></mxCell><mxCell id="tick1_2" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="982" y="474" as="sourcePoint"/><mxPoint x="1072" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub1_2" value="Закрытие не требует подтверждения результата" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="602" y="436" width="380" height="76" as="geometry"/></mxCell><mxCell id="cat2" value="СРЕДСТВА" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=2;fontSize=25;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1150" y="172" width="300" height="58" as="geometry"/></mxCell><mxCell id="bone2" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#2E75B6;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="230" as="sourcePoint"/><mxPoint x="1600" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tick2_0" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1288" y="315" as="sourcePoint"/><mxPoint x="1378" y="315" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub2_0" value="Канала, чтобы подать сигнал минуя заявление, нет" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="908" y="277" width="380" height="76" as="geometry"/></mxCell><mxCell id="tick2_1" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="395" as="sourcePoint"/><mxPoint x="1450" y="395" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub2_1" value="Журнал и документооборот не связаны с исполнением" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="980" y="357" width="380" height="76" as="geometry"/></mxCell><mxCell id="cat3" value="ИНФОРМАЦИЯ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=2;fontSize=25;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="884" width="300" height="58" as="geometry"/></mxCell><mxCell id="bone3" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#2E75B6;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="884" as="sourcePoint"/><mxPoint x="880" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tick3_0" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="568" y="799" as="sourcePoint"/><mxPoint x="658" y="799" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub3_0" value="О проблемах территории данных нет, пока нет жалобы" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="188" y="761" width="380" height="76" as="geometry"/></mxCell><mxCell id="tick3_1" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="722" as="sourcePoint"/><mxPoint x="730" y="722" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub3_1" value="Суть и адрес записываются в свободной форме" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="260" y="684" width="380" height="76" as="geometry"/></mxCell><mxCell id="tick3_2" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="712" y="644" as="sourcePoint"/><mxPoint x="802" y="644" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub3_2" value="Объём очереди не виден ни сотруднику, ни руководителю" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="332" y="606" width="380" height="76" as="geometry"/></mxCell><mxCell id="cat4" value="ВНЕШНИЕ УСЛОВИЯ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=2;fontSize=25;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="950" y="884" width="300" height="58" as="geometry"/></mxCell><mxCell id="bone4" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#2E75B6;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="884" as="sourcePoint"/><mxPoint x="1400" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tick4_0" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1088" y="799" as="sourcePoint"/><mxPoint x="1178" y="799" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub4_0" value="Написать заявление — высокий порог: житель терпит" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="708" y="761" width="380" height="76" as="geometry"/></mxCell><mxCell id="tick4_1" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="722" as="sourcePoint"/><mxPoint x="1250" y="722" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub4_1" value="Срок рассмотрения задан Федеральным законом № 59-ФЗ" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="780" y="684" width="380" height="76" as="geometry"/></mxCell><mxCell id="why" value="«5 ПОЧЕМУ»: от следствия к корню" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDF7EE;strokeColor=#7F7F7F;strokeWidth=1.5;verticalAlign=top;align=center;fontSize=25;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="1010" width="2000" height="496" as="geometry"/></mxCell><mxCell id="wn0" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=#2E75B6;fontColor=#FFFFFF;fontStyle=1;fontSize=21;" vertex="1" parent="why"><mxGeometry x="18" y="60" width="34" height="34" as="geometry"/></mxCell><mxCell id="wq0" value="Почему проблема на территории существует так долго?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" vertex="1" parent="why"><mxGeometry x="64" y="52" width="620" height="74" as="geometry"/></mxCell><mxCell id="wa0" value="Потому что администрация узнаёт о ней только тогда, когда житель напишет обращение, — а до этого проблема никем не выявлена." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=21;fontColor=#595959;" vertex="1" parent="why"><mxGeometry x="700" y="52" width="1276" height="74" as="geometry"/></mxCell><mxCell id="wn1" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=#2E75B6;fontColor=#FFFFFF;fontStyle=1;fontSize=21;" vertex="1" parent="why"><mxGeometry x="18" y="134" width="34" height="34" as="geometry"/></mxCell><mxCell id="wq1" value="Почему администрация узнаёт о проблеме только от жителя?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" vertex="1" parent="why"><mxGeometry x="64" y="126" width="620" height="74" as="geometry"/></mxCell><mxCell id="wa1" value="Потому что планового выявления нет: территорию никто не обходит с задачей находить проблемы и заводить их в работу." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=21;fontColor=#595959;" vertex="1" parent="why"><mxGeometry x="700" y="126" width="1276" height="74" as="geometry"/></mxCell><mxCell id="wn2" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=#2E75B6;fontColor=#FFFFFF;fontStyle=1;fontSize=21;" vertex="1" parent="why"><mxGeometry x="18" y="208" width="34" height="34" as="geometry"/></mxCell><mxCell id="wq2" value="Почему территорию никто не обходит?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" vertex="1" parent="why"><mxGeometry x="64" y="200" width="620" height="74" as="geometry"/></mxCell><mxCell id="wa2" value="Потому что обход не даёт результата: увиденное некуда подать. Активные жители и сотрудники видят проблемы каждый день, но канала у них нет." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=21;fontColor=#595959;" vertex="1" parent="why"><mxGeometry x="700" y="200" width="1276" height="74" as="geometry"/></mxCell><mxCell id="wn3" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=#2E75B6;fontColor=#FFFFFF;fontStyle=1;fontSize=21;" vertex="1" parent="why"><mxGeometry x="18" y="282" width="34" height="34" as="geometry"/></mxCell><mxCell id="wq3" value="Почему увиденное некуда подать?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" vertex="1" parent="why"><mxGeometry x="64" y="274" width="620" height="74" as="geometry"/></mxCell><mxCell id="wa3" value="Потому что единственный вход в процесс — обращение по Федеральному закону № 59-ФЗ: чтобы проблема попала в работу, нужно заявление." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=21;fontColor=#595959;" vertex="1" parent="why"><mxGeometry x="700" y="274" width="1276" height="74" as="geometry"/></mxCell><mxCell id="wn4" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=#2E75B6;fontColor=#FFFFFF;fontStyle=1;fontSize=21;" vertex="1" parent="why"><mxGeometry x="18" y="356" width="34" height="34" as="geometry"/></mxCell><mxCell id="wq4" value="Почему единственный вход — обращение?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" vertex="1" parent="why"><mxGeometry x="64" y="348" width="620" height="74" as="geometry"/></mxCell><mxCell id="wa4" value="Потому что выявление проблемы и рассмотрение обращения никогда не разделялись — это одна процедура, и другой в администрации не заведено." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=21;fontColor=#595959;" vertex="1" parent="why"><mxGeometry x="700" y="348" width="1276" height="74" as="geometry"/></mxCell><mxCell id="root" value="КОРЕННАЯ ПРИЧИНА: выявление проблемы не отделено от рассмотрения обращения. Пока житель не написал заявление, проблемы для процесса не существует — сколько бы людей её ни видело" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C00000;strokeWidth=2;fontSize=23;fontStyle=1;fontColor=#C00000;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="why"><mxGeometry x="18" y="430" width="1964" height="56" as="geometry"/></mxCell><mxCell id="note" value="Факторы на диаграмме — проблемы с карты текущего состояния, разложенные по пяти категориям. Оба инструмента названы в обучающей презентации «Эффективного региона», раздел 2.4" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="1070" y="1510" width="1000" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>