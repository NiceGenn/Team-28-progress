<mxfile host="app.diagrams.net"><diagram name="Анализ причин"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Анализ проблем: диаграмма Исикавы и «5 почему»" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="24" width="2040" height="34" as="geometry"/></mxCell><mxCell id="t2" value="Оптимизация процесса устранения проблем благоустройства и содержания территории Благовещенского муниципального округа за счёт перехода от реагирования на обращения к их плановому выявлению и контролю результата" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="30" y="62" width="2040" height="24" as="geometry"/></mxCell><mxCell id="spine" value="" style="html=1;endArrow=blockThin;endFill=1;strokeWidth=3;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="560" as="sourcePoint"/><mxPoint x="1660" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="head" value="Проблема на территории существует&lt;br&gt;до 44 дней: администрация узнаёт&lt;br&gt;о ней только из обращения жителя" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C00000;strokeWidth=2.5;fontSize=17;fontStyle=1;verticalAlign=middle;align=center;fontColor=#C00000;spacing=8;" vertex="1" parent="1"><mxGeometry x="1674" y="468" width="396" height="184" as="geometry"/></mxCell><mxCell id="cat0" value="ЛЮДИ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=2;fontSize=17;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="178" width="250" height="46" as="geometry"/></mxCell><mxCell id="bone0" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#2E75B6;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="224" as="sourcePoint"/><mxPoint x="675" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tick0_0" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="353" y="311" as="sourcePoint"/><mxPoint x="453" y="311" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub0_0" value="Территорию никто не обходит планово" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="53" y="289" width="300" height="44" as="geometry"/></mxCell><mxCell id="tick0_1" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="425" y="392" as="sourcePoint"/><mxPoint x="525" y="392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub0_1" value="Ресурс активных жителей не задействован" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="125" y="370" width="300" height="44" as="geometry"/></mxCell><mxCell id="tick0_2" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="497" y="472" as="sourcePoint"/><mxPoint x="597" y="472" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub0_2" value="Ответственного определяет лично Глава округа" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="197" y="450" width="300" height="44" as="geometry"/></mxCell><mxCell id="cat1" value="МЕТОДЫ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=2;fontSize=17;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="178" width="250" height="46" as="geometry"/></mxCell><mxCell id="bone1" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#2E75B6;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="224" as="sourcePoint"/><mxPoint x="1125" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tick1_0" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="803" y="311" as="sourcePoint"/><mxPoint x="903" y="311" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub1_0" value="Единственный вход в процесс — обращение жителя" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="503" y="289" width="300" height="44" as="geometry"/></mxCell><mxCell id="tick1_1" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875" y="392" as="sourcePoint"/><mxPoint x="975" y="392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub1_1" value="Единый срок 30 дней на любое обращение" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="575" y="370" width="300" height="44" as="geometry"/></mxCell><mxCell id="tick1_2" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="947" y="472" as="sourcePoint"/><mxPoint x="1047" y="472" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub1_2" value="Закрытие не требует подтверждения результата" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="647" y="450" width="300" height="44" as="geometry"/></mxCell><mxCell id="cat2" value="СРЕДСТВА" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=2;fontSize=17;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1150" y="178" width="250" height="46" as="geometry"/></mxCell><mxCell id="bone2" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#2E75B6;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1275" y="224" as="sourcePoint"/><mxPoint x="1575" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tick2_0" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1253" y="311" as="sourcePoint"/><mxPoint x="1353" y="311" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub2_0" value="Канала, чтобы подать сигнал минуя заявление, нет" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="953" y="289" width="300" height="44" as="geometry"/></mxCell><mxCell id="tick2_1" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1325" y="392" as="sourcePoint"/><mxPoint x="1425" y="392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub2_1" value="Журнал и документооборот не связаны с исполнением" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1025" y="370" width="300" height="44" as="geometry"/></mxCell><mxCell id="cat3" value="ИНФОРМАЦИЯ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=2;fontSize=17;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="876" width="250" height="46" as="geometry"/></mxCell><mxCell id="bone3" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#2E75B6;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="876" as="sourcePoint"/><mxPoint x="855" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tick3_0" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="533" y="793" as="sourcePoint"/><mxPoint x="633" y="793" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub3_0" value="О проблемах территории данных нет, пока нет жалобы" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="233" y="771" width="300" height="44" as="geometry"/></mxCell><mxCell id="tick3_1" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="718" as="sourcePoint"/><mxPoint x="705" y="718" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub3_1" value="Суть и адрес записываются в свободной форме" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="305" y="696" width="300" height="44" as="geometry"/></mxCell><mxCell id="tick3_2" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="677" y="642" as="sourcePoint"/><mxPoint x="777" y="642" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub3_2" value="Объём очереди не виден ни сотруднику, ни руководителю" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="377" y="620" width="300" height="44" as="geometry"/></mxCell><mxCell id="cat4" value="ВНЕШНИЕ УСЛОВИЯ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=2;fontSize=17;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="950" y="876" width="250" height="46" as="geometry"/></mxCell><mxCell id="bone4" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#2E75B6;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1075" y="876" as="sourcePoint"/><mxPoint x="1375" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tick4_0" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1053" y="793" as="sourcePoint"/><mxPoint x="1153" y="793" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub4_0" value="Написать заявление — высокий порог: житель терпит" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="753" y="771" width="300" height="44" as="geometry"/></mxCell><mxCell id="tick4_1" value="" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#595959;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1125" y="718" as="sourcePoint"/><mxPoint x="1225" y="718" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sub4_1" value="Срок рассмотрения задан Федеральным законом № 59-ФЗ" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="825" y="696" width="300" height="44" as="geometry"/></mxCell><mxCell id="why" value="«5 ПОЧЕМУ»: от следствия к корню" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDF7EE;strokeColor=#7F7F7F;strokeWidth=1.5;verticalAlign=top;align=center;fontSize=17;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="1010" width="2000" height="386" as="geometry"/></mxCell><mxCell id="wn0" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=#2E75B6;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" vertex="1" parent="why"><mxGeometry x="18" y="60" width="34" height="34" as="geometry"/></mxCell><mxCell id="wq0" value="Почему проблема на территории существует так долго?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="why"><mxGeometry x="64" y="52" width="560" height="52" as="geometry"/></mxCell><mxCell id="wa0" value="Потому что администрация узнаёт о ней только тогда, когда житель напишет обращение, — а до этого проблема никем не выявлена." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#595959;" vertex="1" parent="why"><mxGeometry x="636" y="52" width="1340" height="52" as="geometry"/></mxCell><mxCell id="wn1" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=#2E75B6;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" vertex="1" parent="why"><mxGeometry x="18" y="112" width="34" height="34" as="geometry"/></mxCell><mxCell id="wq1" value="Почему администрация узнаёт о проблеме только от жителя?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="why"><mxGeometry x="64" y="104" width="560" height="52" as="geometry"/></mxCell><mxCell id="wa1" value="Потому что планового выявления нет: территорию никто не обходит с задачей находить проблемы и заводить их в работу." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#595959;" vertex="1" parent="why"><mxGeometry x="636" y="104" width="1340" height="52" as="geometry"/></mxCell><mxCell id="wn2" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=#2E75B6;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" vertex="1" parent="why"><mxGeometry x="18" y="164" width="34" height="34" as="geometry"/></mxCell><mxCell id="wq2" value="Почему территорию никто не обходит?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="why"><mxGeometry x="64" y="156" width="560" height="52" as="geometry"/></mxCell><mxCell id="wa2" value="Потому что обход не даёт результата: увиденное некуда подать. Активные жители и сотрудники видят проблемы каждый день, но канала у них нет." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#595959;" vertex="1" parent="why"><mxGeometry x="636" y="156" width="1340" height="52" as="geometry"/></mxCell><mxCell id="wn3" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=#2E75B6;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" vertex="1" parent="why"><mxGeometry x="18" y="216" width="34" height="34" as="geometry"/></mxCell><mxCell id="wq3" value="Почему увиденное некуда подать?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="why"><mxGeometry x="64" y="208" width="560" height="52" as="geometry"/></mxCell><mxCell id="wa3" value="Потому что единственный вход в процесс — обращение по Федеральному закону № 59-ФЗ: чтобы проблема попала в работу, нужно заявление." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#595959;" vertex="1" parent="why"><mxGeometry x="636" y="208" width="1340" height="52" as="geometry"/></mxCell><mxCell id="wn4" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=#2E75B6;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" vertex="1" parent="why"><mxGeometry x="18" y="268" width="34" height="34" as="geometry"/></mxCell><mxCell id="wq4" value="Почему единственный вход — обращение?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="why"><mxGeometry x="64" y="260" width="560" height="52" as="geometry"/></mxCell><mxCell id="wa4" value="Потому что выявление проблемы и рассмотрение обращения никогда не разделялись — это одна процедура, и другой в администрации не заведено." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#595959;" vertex="1" parent="why"><mxGeometry x="636" y="260" width="1340" height="52" as="geometry"/></mxCell><mxCell id="root" value="КОРЕННАЯ ПРИЧИНА: выявление проблемы не отделено от рассмотрения обращения. Пока житель не написал заявление, проблемы для процесса не существует — сколько бы людей её ни видело" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C00000;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#C00000;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="why"><mxGeometry x="18" y="320" width="1964" height="56" as="geometry"/></mxCell><mxCell id="note" value="Факторы на диаграмме — проблемы с карты текущего состояния, разложенные по пяти категориям. Оба инструмента названы в обучающей презентации «Эффективного региона», раздел 2.4" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="1070" y="1400" width="1000" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>