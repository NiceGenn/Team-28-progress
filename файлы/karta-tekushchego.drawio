        <mxCell id="t2" value="Оптимизация процесса приёма, маршрутизации и контроля исполнения сообщений граждан о проблемах благоустройства и жизнеобеспечения&lt;br&gt;на территории Благовещенского муниципального округа" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="2340" height="62" as="geometry"/></mxCell>
        <mxCell id="vpp" value="" style="html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="658" as="sourcePoint"/><mxPoint x="2370" y="658" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="vpp_l" value="Общее время протекания процесса = [замер] — [замер]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="637" width="980" height="42" as="geometry"/></mxCell>
        <mxCell id="losses" value="ВЫЯВЛЕННЫЕ ПОТЕРИ:" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF7EE;strokeColor=#7F7F7F;strokeWidth=1.5;verticalAlign=top;align=center;fontSize=15;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="56" y="704" width="1520" height="364" as="geometry"/></mxCell>
        <mxCell id="ln0" value="1." style="text;html=1;align=right;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="losses"><mxGeometry x="14" y="48" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="lt0" value="Единого канала обращения нет: гражданин выбирает способ наугад, часть сообщений не доходит до администрации вовсе" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="losses"><mxGeometry x="52" y="48" width="1450" height="30" as="geometry"/></mxCell>
        <mxCell id="ln1" value="2." style="text;html=1;align=right;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="losses"><mxGeometry x="14" y="78" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="lt1" value="Сообщение фиксируется в свободной форме — суть, адрес и контакт записываются неполно, детали теряются" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="losses"><mxGeometry x="52" y="78" width="1450" height="30" as="geometry"/></mxCell>
        <mxCell id="ln2" value="3." style="text;html=1;align=right;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="losses"><mxGeometry x="14" y="108" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="lt2" value="Очередь необработанных сообщений копится и не видна ни сотруднику, ни руководителю: объём незавершённой работы неизвестен" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="losses"><mxGeometry x="52" y="108" width="1450" height="30" as="geometry"/></mxCell>
        <mxCell id="ln3" value="4." style="text;html=1;align=right;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="losses"><mxGeometry x="14" y="138" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="lt3" value="Зона ответственности определяется вручную, по памяти сотрудника — результат зависит от того, кто принял сообщение" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="losses"><mxGeometry x="52" y="138" width="1450" height="30" as="geometry"/></mxCell>
        <mxCell id="ln4" value="5." style="text;html=1;align=right;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="losses"><mxGeometry x="14" y="168" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="lt4" value="Поручение передаётся без документа: факт передачи не подтверждён, сообщение может потеряться на этом шаге" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="losses"><mxGeometry x="52" y="168" width="1450" height="30" as="geometry"/></mxCell>
        <mxCell id="ln5" value="6." style="text;html=1;align=right;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="losses"><mxGeometry x="14" y="198" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="lt5" value="Срок исполнения не устанавливается и не контролируется — просрочка не выявляется до момента жалобы" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="losses"><mxGeometry x="52" y="198" width="1450" height="30" as="geometry"/></mxCell>
        <mxCell id="ln6" value="7." style="text;html=1;align=right;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="losses"><mxGeometry x="14" y="228" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="lt6" value="Результат не фиксируется документально: подтверждения устранения нет ни у исполнителя, ни у руководителя" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="losses"><mxGeometry x="52" y="228" width="1450" height="30" as="geometry"/></mxCell>
        <mxCell id="ln7" value="8." style="text;html=1;align=right;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="losses"><mxGeometry x="14" y="258" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="lt7" value="Гражданин не получает ответа о результате — обратная связь в процессе не предусмотрена" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="losses"><mxGeometry x="52" y="258" width="1450" height="30" as="geometry"/></mxCell>
