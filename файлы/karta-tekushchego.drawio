        <mxCell id="hw8" value="10 этап" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#ED1C24;" vertex="1" parent="hedges"><mxGeometry x="70" y="546" width="90" height="48" as="geometry"/></mxCell>
        <mxCell id="ht8" value="Повторные обращения об одной и той же проблеме не выявляются: работа по одному объекту заводится и выполняется несколько раз" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="hedges"><mxGeometry x="166" y="546" width="1516" height="48" as="geometry"/></mxCell>
        <mxCell id="hs9" value="10" style="shape=mxgraph.basic.8_point_star;whiteSpace=wrap;html=1;fillColor=#ED1C24;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" vertex="1" parent="hedges"><mxGeometry x="14" y="608" width="46" height="46" as="geometry"/></mxCell>
        <mxCell id="hw9" value="9 этап" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#ED1C24;" vertex="1" parent="hedges"><mxGeometry x="70" y="608" width="90" height="48" as="geometry"/></mxCell>
        <mxCell id="ht9" value="Сводка собирается вручную, данные о просрочке и нагрузке недостоверны и запаздывают" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="hedges"><mxGeometry x="166" y="608" width="1516" height="48" as="geometry"/></mxCell>
        <mxCell id="waste" value="ВИДЫ ПОТЕРЬ  ·  классификация и порядок — тренинг «Эффективный регион» (sources/08)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;align=left;verticalAlign=top;fontSize=15;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="820" width="1700" height="546" as="geometry"/></mxCell>
        <mxCell id="wn0" value="1. Перепроизводство" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="waste"><mxGeometry x="14" y="50" width="400" height="54" as="geometry"/></mxCell>
        <mxCell id="ww0" value="2, 7, 10 этапы" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#ED1C24;" vertex="1" parent="waste"><mxGeometry x="420" y="50" width="200" height="54" as="geometry"/></mxCell>
        <mxCell id="wt0" value="несколько граждан сообщают об одной проблеме — по каждому сообщению заводится отдельная работа и отдельно выезжает исполнитель" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="waste"><mxGeometry x="628" y="50" width="1054" height="54" as="geometry"/></mxCell>
        <mxCell id="wn1" value="2. Лишние движения" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="waste"><mxGeometry x="14" y="112" width="400" height="54" as="geometry"/></mxCell>
        <mxCell id="ww1" value="4 этап" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#ED1C24;" vertex="1" parent="waste"><mxGeometry x="420" y="112" width="200" height="54" as="geometry"/></mxCell>
        <mxCell id="wt1" value="сотрудник вручную ищет, чья это зона ответственности, и поднимает историю прежних обращений" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="waste"><mxGeometry x="628" y="112" width="1054" height="54" as="geometry"/></mxCell>
        <mxCell id="wn2" value="3. Ненужная транспортировка" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="waste"><mxGeometry x="14" y="174" width="400" height="54" as="geometry"/></mxCell>
        <mxCell id="ww2" value="3, 5, 8 этапы" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#ED1C24;" vertex="1" parent="waste"><mxGeometry x="420" y="174" width="200" height="54" as="geometry"/></mxCell>
        <mxCell id="wt2" value="суть сообщения пересказывается по цепочке: гражданин → приёмная → записка или звонок → исполнитель, с потерей деталей" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="waste"><mxGeometry x="628" y="174" width="1054" height="54" as="geometry"/></mxCell>
        <mxCell id="wn3" value="4. Излишние запасы" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="waste"><mxGeometry x="14" y="236" width="400" height="54" as="geometry"/></mxCell>
        <mxCell id="ww3" value="очередь после 3 этапа" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#ED1C24;" vertex="1" parent="waste"><mxGeometry x="420" y="236" width="200" height="54" as="geometry"/></mxCell>
        <mxCell id="wt3" value="необработанные сообщения копятся в разных каналах и на разных столах, объём очереди никому не виден" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="waste"><mxGeometry x="628" y="236" width="1054" height="54" as="geometry"/></mxCell>
        <mxCell id="wn4" value="5. Избыточная обработка" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="waste"><mxGeometry x="14" y="298" width="400" height="54" as="geometry"/></mxCell>
        <mxCell id="ww4" value="3, 9 этапы" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#ED1C24;" vertex="1" parent="waste"><mxGeometry x="420" y="298" width="200" height="54" as="geometry"/></mxCell>
        <mxCell id="wt4" value="одно сообщение переписывается трижды: в журнал, исполнителю, в отчётность" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="waste"><mxGeometry x="628" y="298" width="1054" height="54" as="geometry"/></mxCell>
        <mxCell id="wn5" value="6. Ожидание" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="waste"><mxGeometry x="14" y="360" width="400" height="54" as="geometry"/></mxCell>
        <mxCell id="ww5" value="3, 6, 7, 10 этапы" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#ED1C24;" vertex="1" parent="waste"><mxGeometry x="420" y="360" width="200" height="54" as="geometry"/></mxCell>
        <mxCell id="wt5" value="сообщение ждёт ручной регистрации и передачи; исполнение идёт без установленного срока" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="waste"><mxGeometry x="628" y="360" width="1054" height="54" as="geometry"/></mxCell>
        <mxCell id="wn6" value="7. Переделка и брак" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="waste"><mxGeometry x="14" y="422" width="400" height="54" as="geometry"/></mxCell>
        <mxCell id="ww6" value="8, 10 этапы" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#ED1C24;" vertex="1" parent="waste"><mxGeometry x="420" y="422" width="200" height="54" as="geometry"/></mxCell>
        <mxCell id="wt6" value="формальное закрытие без подтверждённого результата — гражданин обращается повторно" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="waste"><mxGeometry x="628" y="422" width="1054" height="54" as="geometry"/></mxCell>
        <mxCell id="wn7" value="8. Неиспользование человеческого потенциала" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="waste"><mxGeometry x="14" y="484" width="400" height="54" as="geometry"/></mxCell>
        <mxCell id="ww7" value="3–5, 9 этапы" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#ED1C24;" vertex="1" parent="waste"><mxGeometry x="420" y="484" width="200" height="54" as="geometry"/></mxCell>
        <mxCell id="wt7" value="квалифицированный сотрудник занят механической регистрацией, диспетчеризацией и сбором сводок" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="waste"><mxGeometry x="628" y="484" width="1054" height="54" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
