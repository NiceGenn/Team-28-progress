        <mxCell id="lt8" value="Повторные обращения об одной и той же проблеме не выявляются: работа по одному объекту заводится и выполняется несколько раз" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="losses"><mxGeometry x="52" y="288" width="1450" height="30" as="geometry"/></mxCell>
