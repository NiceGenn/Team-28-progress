"2220" y="340" as="targetPoint" /></mxGeometry></mxCell><mxCell id="doc3" value="Карточка заявки&lt;br&gt;в единой очереди&lt;br&gt;электронная, видна всем ролям" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=16;verticalAlign=top;spacingTop=4;fontFamily=Liberation Sans;fontColor=#000000;spacing=2;" vertex="1" parent="1"><mxGeometry x="684" y="588" width="192" height="84" as="geometry" /></mxCell><mxCell id="dl3" value="" style="html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#3399FF;dashed=1;dashPattern=8 6;rounded=0;fontFamily=Liberation Sans;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="560" as="sourcePoint" /><mxPoint x="780" y="588" as="targetPoint" /></mxGeometry></mxCell><mxCell id="doc5" value="Срок исполнения&lt;br&gt;по категории&lt;br&gt;таймер, эскалация по просрочке" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=16;verticalAlign=top;spacingTop=4;fontFamily=Liberation Sans;fontColor=#000000;spacing=2;" vertex="1" parent="1"><mxGeometry x="1124" y="588" width="192" height="84" as="geometry" /></mxCell><mxCell id="dl5" value="" style="html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#3399FF;dashed=1;dashPattern=8 6;rounded=0;fontFamily=Liberation Sans;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="560" as="sourcePoint" /><mxPoint x="1220" y="588" as="targetPoint" /></mxGeometry></mxCell><mxCell id="doc8" value="Отчёт: текст, фото при наличии" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=16;verticalAlign=top;spacingTop=4;fontFamily=Liberation Sans;fontColor=#000000;spacing=2;" vertex="1" parent="1"><mxGeometry x="1784" y="588" width="192" height="84" as="geometry" /></mxCell><mxCell id="dl8" value="" style="html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#3399FF;dashed=1;dashPattern=8 6;rounded=0;fontFamily=Liberation Sans;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1880" y="560" as="sourcePoint" /><mxPoint x="1880" y="588" as="targetPoint" /></mxGeometry></mxCell><mxCell id="t1" value="Карта целевого состояния" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="1" visible="0"><mxGeometry x="30" y="22" width="2072" height="30" as="geometry" /></mxCell><mxCell id="t2" value="Оптимизация процесса устранения проблем благоустройства и содержания территории Благовещенского муниципального округа&lt;br&gt;за счёт перехода от реагирования на обращения к их плановому выявлению и контролю результата" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="1" visible="0"><mxGeometry x="30" y="56" width="2072" height="62" as="geometry" /></mxCell><mxCell id="vpp" value="" style="html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#000000;rounded=0;fontFamily=Liberation Sans;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="702" as="sourcePoint" /><mxPoint x="2420" y="702" as="targetPoint" /></mxGeometry></mxCell><mxCell id="vpp_l" value="Общее время протекания процесса = 1 дн. 2 ч. 35 мин. — 17 дн. 4 ч. 26 мин." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#00A650;fontFamily=Liberation Sans;" vertex="1" parent="1"><mxGeometry x="350" y="680" width="1740" height="44" as="geometry" /></mxCell><mxCell id="vpp_n" value="Было: 10 дн. 2 ч. 55 мин. — 44 дн..   Стало: 1 дн. 2 ч. 35 мин. — 17 дн. 4 ч. 26 мин..   Время указано в календарных днях" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#595959;fontFamily=Liberation Sans;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="735" width="2360" height="36" as="geometry" /></mxCell><mxCell id="acts" value="ПРЕДЛАГАЕМЫЕ РЕШЕНИЯ:" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF7EE;strokeColor=#7F7F7F;strokeWidth=1.5;verticalAlign=top;align=center;fontSize=20;fontStyle=1;spacing=12;fontFamily=Liberation Sans;fontColor=#000000;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="20" y="781" width="2400" height="310" as="geometry" /></mxCell><mxCell id="an0" value="1." style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontStyle=1;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="acts"><mxGeometry x="12" y="40" width="36" height="65" as="geometry" /></mxCell><mxCell id="at0" value="Плановое выявление: инициативные группы обходят закреплённую территорию и подают заявки сами — проблема попадает в работу до обращения жителя" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="acts"><mxGeometry x="50" y="40" width="740" height="65" as="geometry" /></mxCell><mxCell id="an1" value="2." style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontStyle=1;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="acts"><mxGeometry x="12" y="105" width="36" height="65" as="geometry" /></mxCell><mxCell id="at1" value="Ресурс активных жителей включён: инициативные группы получают роль в сервисе и подают заявки через тот же бот" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="acts"><mxGeometry x="50" y="105" width="740" height="65" as="geometry" /></mxCell><mxCell id="an2" value="3." style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontStyle=1;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="acts"><mxGeometry x="12" y="170" width="36" height="65" as="geometry" /></mxCell><mxCell id="at2" value="Единый цифровой канал приёма в мессенджере MAX: выбирать способ обращения больше не нужно" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="acts"><mxGeometry x="50" y="170" width="740" height="65" as="geometry" /></mxCell><mxCell id="an3" value="4." style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontStyle=1;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="acts"><mxGeometry x="12" y="235" width="36" height="65" as="geometry" /></mxCell><mxCell id="at3" value="Структурированный приём: текст, фотография и геометка в одном сообщении; категорию, адрес и срочность определяет ИИ-классификатор" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="acts"><mxGeometry x="50" y="235" width="740" height="65" as="geometry" /></mxCell><mxCell id="an4" value="5." style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontStyle=1;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="acts"><mxGeometry x="810" y="40" width="36" height="65" as="geometry" /></mxCell><mxCell id="at4" value="Заявка уходит исполнителю сразу после классификации — очередь на разбор исчезает, объём работы виден на дашборде" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="acts"><mxGeometry x="848" y="40" width="740" height="65" as="geometry" /></mxCell><mxCell id="an5" value="6." style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontStyle=1;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="acts"><mxGeometry x="810" y="105" width="36" height="65" as="geometry" /></mxCell><mxCell id="at5" value="Отчётность строится сама: сроки, нагрузка и статистика по направлениям в панели администрации в реальном времени" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="acts"><mxGeometry x="848" y="105" width="740" height="65" as="geometry" /></mxCell><mxCell id="an6" value="7." style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontStyle=1;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="acts"><mxGeometry x="810" y="170" width="36" height="65" as="geometry" /></mxCell><mxCell id="at6" value="Маршрутизация по цепочкам ответственных без участия первого лица: Глава округа подключается только при эскалации" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="acts"><mxGeometry x="848" y="170" width="740" height="65" as="geometry" /></mxCell><mxCell id="an7" value="8." style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontStyle=1;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="acts"><mxGeometry x="810" y="235" width="36" height="65" as="geometry" /></mxCell><mxCell id="at7" value="Срок исполнения ставится по категории заявки и контролируется таймером; просрочка поднимается заму направления, затем Главе округа" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="acts"><mxGeometry x="848" y="235" width="740" height="65" as="geometry" /></mxCell><mxCell id="an8" value="9." style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontStyle=1;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="acts"><mxGeometry x="1608" y="40" width="36" height="65" as="geometry" /></mxCell><mxCell id="at8" value="Результат фиксируется текстовым ответом; фото при наличии. Закрытие оператором не означает личного подтверждения жителя." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="acts"><mxGeometry x="1646" y="40" width="740" height="65" as="geometry" /></mxCell><mxCell id="an9" value="10." style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontStyle=1;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="acts"><mxGeometry x="1608" y="105" width="36" height="65" as="geometry" /></mxCell><mxCell id="at9" value="Автор заявки получает уведомление о каждом изменении статуса в свой мессенджер — от приёма до устранения" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="acts"><mxGeometry x="1646" y="105" width="740" height="65" as="geometry" /></mxCell><mxCell id="an10" value="11." style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontStyle=1;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="acts"><mxGeometry x="1608" y="170" width="36" height="65" as="geometry" /></mxCell><mxCell id="at10" value="Дедупликация по координатам и нормализованному адресу: заявки об одной проблеме объединяются автоматически" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="acts"><mxGeometry x="1646" y="170" width="740" height="65" as="geometry" /></mxCell><mxCell id="an11" value="12." style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontStyle=1;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;" vertex="1" parent="acts"><mxGeometry x="1608" y="235" width="36" height="65" as="geometry" /></mxCell><mxCell id="at11" value="Ответ приходит в мессенджер в момент закрытия заявки — доставка почтой не требуется" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="acts"><mxGeometry x="1646" y="235" width="740" height="65" as="geometry" /></mxCell><mxCell id="act_mark" value="" style="shape=mxgraph.basic.8_point_star;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontFamily=Liberation Sans;" vertex="1" parent="1"><mxGeometry x="25" y="768" width="45" height="45" as="geometry" /></mxCell><mxCell id="leg" value="Условные обозначения" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF7EE;strokeColor=#7F7F7F;strokeWidth=1.5;verticalAlign=top;align=center;fontSize=18;fontStyle=1;spacing=12;fontFamily=Liberation Sans;fontColor=#000000;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="1102" width="2400" height="100" as="geometry" /></mxCell><mxCell id="lg0" value="" style="ellipse;fillColor=#00A650;strokeColor=#00A650;html=1;fontFamily=Liberation Sans;fontColor=#000000;" vertex="1" parent="leg"><mxGeometry x="12" y="30" width="26" height="26" as="geometry" /></mxCell><mxCell id="lgt0" value="— вход процесса" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="leg"><mxGeometry x="46" y="28" width="730" height="32" as="geometry" /></mxCell><mxCell id="lg1" value="" style="ellipse;fillColor=#ED1C24;strokeColor=#000000;strokeWidth=2.5;html=1;fontFamily=Liberation Sans;fontColor=#000000;" vertex="1" parent="leg"><mxGeometry x="810" y="30" width="26" height="26" as="geometry" /></mxCell><mxCell id="lgt1" value="— выход процесса" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="leg"><mxGeometry x="844" y="28" width="730" height="32" as="geometry" /></mxCell><mxCell id="lg2" style="html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#000000;rounded=0;fontFamily=Liberation Sans;fontColor=#000000;" edge="1" parent="leg"><mxGeometry relative="1" as="geometry"><mxPoint x="1608" y="42" as="sourcePoint" /><mxPoint x="1634" y="42" as="targetPoint" /></mxGeometry></mxCell><mxCell id="lgt2" value="— направление процесса" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="leg"><mxGeometry x="1642" y="28" width="730" height="32" as="geometry" /></mxCell><mxCell id="lg3" value="1" style="shape=mxgraph.basic.8_point_star;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Liberation Sans;" vertex="1" parent="leg"><mxGeometry x="12" y="62" width="26" height="26" as="geometry" /></mxCell><mxCell id="lgt3" value="— мероприятие, номер — в списке слева" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="leg"><mxGeometry x="46" y="60" width="730" height="32" as="geometry" /></mxCell><mxCell id="lg4" value="" style="shape=document;fillColor=#FFFFFF;strokeColor=#000000;htm