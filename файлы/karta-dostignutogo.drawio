okeWidth=1;fontSize=18;verticalAlign=middle;spacing=1;fontFamily=Liberation Sans;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1780" y="154" width="200" height="84" as="geometry" /></mxCell><mxCell id="c8_b" value="Закрытие с фотографией или отчётом. Без подтверждения закрыть нельзя" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1784" y="248" width="192" height="306" as="geometry" /></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DC3E6;strokeWidth=1.5;fontFamily=Liberation Sans;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2000" y="60" width="200" height="500" as="geometry" /></mxCell><mxCell id="c9_h" value="9 этап&lt;br&gt;10 мин. — 7 дн.&lt;br&gt;(расчёт)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=1.5;fontSize=22;fontStyle=1;fontColor=#000000;verticalAlign=middle;spacing=1;fontFamily=Liberation Sans;" vertex="1" parent="1"><mxGeometry x="2000" y="60" width="200" height="94" as="geometry" /></mxCell><mxCell id="c9_r" value="Инициативная группа / житель" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9DC3E6;strokeWidth=1;fontSize=20;verticalAlign=middle;spacing=1;fontFamily=Liberation Sans;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2000" y="154" width="200" height="84" as="geometry" /></mxCell><mxCell id="c9_b" value="Уведомление «до и после», подтверждение и оценка от 1 до 5. Оценка ниже трёх возвращает заявку в работу" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="2004" y="248" width="192" height="306" as="geometry" /></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=