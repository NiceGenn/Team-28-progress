rokeWidth=1.5;fontSize=14;fontStyle=1;fontColor=#000000;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="600" y="148" width="172" height="52" as="geometry"/></mxCell><mxCell id="c3_r" value="Сервис приёма сообщений" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9DC3E6;strokeWidth=1;fontSize=13;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="600" y="200" width="172" height="58" as="geometry"/></mxCell><mxCell id="c3_b" value="Проверка на повтор: обращения об одной проблеме объединяются" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="606" y="258" width="160" height="236" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DC3E6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="790" y="148" width="172" height="356" as="geometry"/></mxCell><mxCell id="c4_h" value="4 этап&lt;br&gt;1 мин. — 2 мин.&lt;br&gt;(расчёт)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=1.5;fontSize=14;fontStyle=1;fontColor=#000000;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="790" y="148" width="172" height="52" as="geometry"/></mxCell><mxCell id="c4_r" value="Сервис приёма сообщений" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9DC3E6;strokeWidth=1;fontSize=13;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="790" y="200" width="172" height="58" as="geometry"/></mxCell><mxCell id="c4_b" value="Маршрутизация исполнителю по цепочке ответственных. Срок исполнения ставится автоматически" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="796" y="258" width="160" height="236" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DC3E6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="980" y="148" width="172" height="356" as="geometry"/></mxCell><mxCell id="c5_h" value="5 этап&lt;br&gt;15 мин. — 4 ч.&lt;br&gt;(расчёт)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=1.5;fontSize=14;fontStyle=1;fontColor=#000000;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="980" y="148" width="172" height="52" as="geometry"/></mxCell><mxCell id="c5_r" value="Исполнитель — подразделение администрации" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9DC3E6;strokeWidth=1;fontSize=13;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="980" y="200" width="172" height="58" as="geometry"/></mxCell><mxCell id="c5_b" value="Заявка приходит целиком: текст, фото, точка на карте. Кнопка «Взять в работу»" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="986" y="258" width="160" height="236" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DC3E6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1170" y="148" width="172" height="356" as="geometry"/></mxCell><mxCell id="c6_h" value="6 этап&lt;br&gt;2 ч. — 3 дн.&lt;br&gt;(расчёт)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=1.5;fontSize=14;fontStyle=1;fontColor=#000000;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="1170" y="148" width="172" height="52" as="geometry"/></mxCell><mxCell id="c6_r" value="Исполнитель — подразделение администрации" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9DC3E6;strokeWidth=1;fontSize=13;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="1170" y="200" width="172" height="58" as="geometry"/></mxCell><mxCell id="c6_b" value="Выполнение работ в установленный срок. Просрочка под