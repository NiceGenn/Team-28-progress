<mxfile host="app.diagrams.net"><diagram name="Достигнутое состояние"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1942" pageHeight="1216" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c0" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00A650;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="148" width="172" height="356" as="geometry"/></mxCell><mxCell id="c0_h" value="Вход процесса" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00A650;strokeColor=#00A650;strokeWidth=1.5;fontSize=14;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="148" width="172" height="52" as="geometry"/></mxCell><mxCell id="c0_r" value="Гражданин" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#00A650;strokeWidth=1;fontSize=13;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="172" height="58" as="geometry"/></mxCell><mxCell id="c0_b" value="Гражданин обнаружил проблему благоустройства или жизнеобеспечения" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="36" y="258" width="160" height="236" as="geometry"/></mxCell><mxCell id="c1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DC3E6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="220" y="148" width="172" height="356" as="geometry"/></mxCell><mxCell id="c1_h" value="1 этап&lt;br&gt;2 мин. — 5 мин.&lt;br&gt;(расчёт)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=1.5;fontSize=14;fontStyle=1;fontColor=#000000;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="220" y="148" width="172" height="52" as="geometry"/></mxCell><mxCell id="c1_r" value="Гражданин" style="