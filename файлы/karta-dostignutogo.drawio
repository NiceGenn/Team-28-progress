dge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1446" y="504" as="sourcePoint"/><mxPoint x="1446" y="534" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t1" value="Карта достигнутого состояния" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="1882" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Оптимизация процесса приёма, маршрутизации и контроля исполнения сообщений граждан о проблемах благоустройства и жизнеобеспечения&lt;br&gt;на территории Благовещенского муниципального округа" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1882" height="62" as="geometry"/></mxCell><mxCell id="vpp" value="" style="html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="658" as="sourcePoint"/><mxPoint x="1912" y="658" as="targetPoint"/></mxGeometry></mxCell><mxCell id="vpp_l" value="Фактическое время протекания процесса = 2 ч. 35 мин. — 10 дн. 4 ч. 26 мин.  (расчёт)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#C00000;" vertex="1" parent="1"><mxGeometry x="411" y="637" width="1120" height="42" as="geometry"/></mxCell><mxCell id="vpp_n" value="Было: 7 дн. 2 ч. 55 мин. — 30 дн..   Стало: 2 ч. 35 мин. — 10 дн. 4 ч. 26 мин..   Время указано в календарных днях" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="411" y="682" width="1120" height="26" as="geometry"/></mxCell><mxCell id="res" value="ДОСТИГНУТЫЕ РЕЗУЛЬТАТЫ:" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF7EE;strokeColor=#7F7F7F;strokeWidth=1.5;verticalAlign=top;align=center;fontSize=15;fontStyle=1;spacing=12;" vertex="1" parent="1"><mxGeometry x="56" y="750" width="1520" height="370" as="geometry"/></mxCell><mxCell id="rh0" value="Показатель" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#595959;" vertex="1" parent="res"><mxGeometry x="24" y="44" width="1000" height="34" as="geometry"/></mxCell><mxCell id="rh1" value="Было" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#595959;" vertex="1" parent="res"><mxGeometry x="1024" y="44" width="240" height="34" as="geometry"/></mxCell><mxCell id="rh2" value="Стало" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#595959;" vertex="1" parent="res"><mxGeometry x="1274" y="44" width="240" height="34" as="geometry"/></mxCell><mxCell id="rt0" value="Время протекания процесса, календ. дн." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="res"><mxGeometry x="24" y="78" width="1000" height="34" as="geometry"/></mxCell><mxCell id="rb0" value="7 — 30" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#000000;" vertex="1" parent="res"><mxGeometry x="1024" y="78" width="240" height="34" as="geometry"/></mxCell><mxCell id="rs0" value="[факт]" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#C00000;" vertex="1" parent="res"><mxGeometry x="1274" y="78" width="240" height="34" as="geometry"/></mxCell><mxCell id="rt1" value="Трудозатраты на регистрацию одного сообщения, мин." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="res"><mxGeometry x="24" y="112" width="1000" height="34" as="geometry"/></mxCell><mxCell id="rb1" value="[факт]" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#C00000;" vertex="1" parent="res"><mxGeometry x="1024" y="112" width="240" height="34" as="geometry"/></mxCell><mxCell id="rs1" value="[факт]" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontC