<mxfile host="app.diagrams.net"><diagram name="Достигнутое состояние"><mxGraphModel dx="2440" dy="1250" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0" style="fontFamily=Liberation Sans;fontColor=#000000;" /><mxCell id="1" parent="0" style="fontFamily=Liberation Sans;fontColor=#000000;" /><mxCell id="c0" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00A650;strokeWidth=1.5;fontFamily=Liberation Sans;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="200" height="500" as="geometry" /></mxCell><mxCell id="c0_h" value="Вход процесса" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00A650;strokeColor=#00A650;strokeWidth=1.5;fontSize=22;fontStyle=1;fontColor=#FFFFFF;verticalAlign=middle;spacing=1;fontFamily=Liberation Sans;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="200" height="94" as="geometry" /></mxCell><mxCell id="c0_r" value="Территория округа" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#00A650;strokeWidth=1;fontSize=20;verticalAlign=middle;spacing=1;fontFamily=Liberation Sans;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="154" width="200" height="84" as="geometry" /></mxCell><mxCell id="c0_b" value="На территории округа возникла проблема содержания: яма, неработающий фонарь, свалка, подтопление" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="248" width="192" height="306" as="geometry" /></mxCell><mxCell id="c1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DC3E6;strokeWidth=1.5;fontFamily=Liberation Sans;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="240" y="60" width="200" height="500" as="geometry" /></mxCell><mxCell id="c1_h" value="1 этап&lt;br&gt;1 дн. — 7 дн.&lt;br&gt;(расчёт)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=1.5;fontSize=22;fontStyle=1;fontColor=#000000;verticalAlign=middle;spacing=1;fontFamily=Liberation Sans;" vertex="1" parent="1"><mxGeometry x="240" y="60" width="200" height="94" as="geometry" /></mxCell><mxCell id="c1_r" value="Инициативная группа" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9DC3E6;strokeWidth=1;fontSize=20;verticalAlign=middle;spacing=1;fontFamily=Liberation Sans;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="240" y="154" width="200" height="84" as="geometry" /></mxCell><mxCell id="c1_b" value="Проблемы находят на местах инициативные группы при обходе территории. Обращение жителя не требуется" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontFamily=Liberation Sans;fontColor=#000000;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="244" y="248" width="192" height="306" as="geometry" /></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DC3E6;strokeWidth=1.5;fontFamily=Liberation Sans;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="460" y="60" width="200" height="500" as="geometry" /></mxCell><mxCell id="c2_h" value="2 этап&lt;br&gt;2 мин. — 5 мин.&lt;br&gt;(расчёт)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#9DC3E6;strokeWidth=1.5;fontSize=22;fontStyle=1;fontColor=#000000;verticalAlign=middle;spacing=1;fontFamily=Liberation Sans;" vertex="1" parent="1"><mxGeometry x="460" y="60" width="200" height="94" as="geometry" /></mxCell><mxCell id="c2_r" value="Инициативная группа / житель" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9DC3E6;strokeWidth=1;fontSize=20;verticalAlign=middle;spacing=1;fontFamily=Liberation Sans;fontColor=#000000;" vertex="1" parent=